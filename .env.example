# === Mode Selection ===
# "scraper"  = Free via @the-convocation/twitter-scraper (requires Twitter login)
# "rettiwt"  = Free via rettiwt-api (guest mode needs no credentials; full mode needs RETTIWT_API_KEY)
# "api"      = Official Twitter API v2 (paid, full features)
TWITTER_MODE=scraper

# === Scraper Mode ===
# Your regular Twitter/X login credentials
TWITTER_USERNAME=your_twitter_username
TWITTER_PASSWORD=your_twitter_password
TWITTER_EMAIL=your_email_optional

# === Rettiwt Mode ===
# Optional: without this, only get_tweet and get_user_profile work (guest auth).
# With this key, all 4 tools work.
# How to get it: https://rishikant181.github.io/Rettiwt-API/#authentication
#   1. Install the X Auth Helper browser extension
#   2. Log in to Twitter in incognito mode
#   3. Click the extension → "Get Key" → copy the value
RETTIWT_API_KEY=your_rettiwt_api_key

# === API Mode (Official Twitter API v2) ===
# Get credentials at: https://developer.x.com/en/portal/dashboard
TWITTER_BEARER_TOKEN=your_bearer_token
TWITTER_API_KEY=your_api_key
TWITTER_API_SECRET=your_api_secret
TWITTER_ACCESS_TOKEN=your_access_token
TWITTER_ACCESS_SECRET=your_access_secret
