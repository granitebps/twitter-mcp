# Default: free Rettiwt provider. RETTIWT_API_KEY is required.
TWITTER_MODE=rettiwt
RETTIWT_API_KEY=your_rettiwt_api_key

# Optional: official X API mode. Use a bearer token or the complete OAuth set.
# TWITTER_MODE=api
# TWITTER_BEARER_TOKEN=your_bearer_token
# TWITTER_API_KEY=your_api_key
# TWITTER_API_SECRET=your_api_secret
# TWITTER_ACCESS_TOKEN=your_access_token
# TWITTER_ACCESS_SECRET=your_access_secret

# Optional request deadline. Valid range: 1000 to 120000 milliseconds.
TWITTER_REQUEST_TIMEOUT_MS=30000

# Required only by npm run test:live. Use a public post with an available author.
TWITTER_LIVE_TWEET_ID=your_test_tweet_id
